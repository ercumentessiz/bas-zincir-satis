rules_version = '2';

// Bu kuralları Firebase Console > Firestore Database > Kurallar (Rules)
// sekmesine yapıştırın ve "Yayınla" (Publish) butonuna basın.
//
// Uygulama artık e-posta/şifre ile giriş gerektirir (Anonim giriş
// KULLANILMAZ). Aşağıdaki kurallar, giriş yapmış olmanın yanında,
// giriş yapan hesabın e-postasının bu listede olmasını da zorunlu kılar.
// Listede olmayan biri (yanlışlıkla farklı bir Firebase hesabı oluşturulsa
// bile) okuma veya yazma yapamaz.
//
// Yeni birine erişim vermek/kaldırmak isterseniz, hem bu listeyi hem de
// Firebase Console > Authentication > Users bölümündeki hesap listesini
// güncellemeniz gerekir.

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email in [
          'pdrercumentessiz@gmail.com',
          'baszincirosb@gmail.com',
          'baszincir@gmail.com',
          'pazarlama2@baszincir.com.tr'
        ];
    }
  }
}
